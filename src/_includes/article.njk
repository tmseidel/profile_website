---
layout: base.njk
---
<article class="article-page">
  <div class="container">
    {% set recommendedArticle = articleNext[page.fileSlug] %}
    <header class="article-header">
      <div class="article-meta">
        <span class="article-date">{{ date | dateFormat }}</span>
        {% if tags %}
        <div class="article-tags">
          {% for tag in tags %}{% if tag != "articles" %}<span class="tag">{{ tag }}</span>{% endif %}{% endfor %}
        </div>
        {% endif %}
      </div>
      <h1>{{ title }}</h1>
      {% if description %}<p class="article-lead">{{ description }}</p>{% endif %}
    </header>
    {% if recommendedArticle %}
    <aside class="article-next article-next--top" aria-label="Recommended next article">
      <p class="article-next-label">Recommended next read</p>
      <div>
        <a href="{{ recommendedArticle.url }}" class="article-next-title">{{ recommendedArticle.title }}</a>
        <p class="article-next-description">{{ recommendedArticle.description }}</p>
        <a href="{{ recommendedArticle.url }}" class="article-next-link">{{ recommendedArticle.cta }} <span aria-hidden="true">→</span></a>
      </div>
    </aside>
    {% endif %}
    <div class="article-body">
      {{ content | safe }}
    </div>
    {% if recommendedArticle %}
    <aside class="article-next article-next--bottom" aria-label="Recommended next article">
      <p class="article-next-label">Continue exploring</p>
      <div>
        <a href="{{ recommendedArticle.url }}" class="article-next-title">{{ recommendedArticle.title }}</a>
        <p class="article-next-description">{{ recommendedArticle.description }}</p>
        <a href="{{ recommendedArticle.url }}" class="article-next-link">{{ recommendedArticle.cta }} <span aria-hidden="true">→</span></a>
      </div>
    </aside>
    {% endif %}
    <footer class="article-footer">
      <a href="/articles/" class="btn-back">&larr; Back to Articles</a>
    </footer>
  </div>
</article>
