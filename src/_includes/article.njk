---
layout: base.njk
---
<article class="article-page">
  <div class="container">
    {% set recommendedArticle = articleNext[page.fileSlug] %}
    <header class="article-header">
      <div class="article-meta">
        <span class="article-date">{{ date | dateFormat }}</span>
        {% if tags %}
        <div class="article-tags">
          {% for tag in tags %}{% if tag != "articles" %}<span class="tag">{{ tag }}</span>{% endif %}{% endfor %}
        </div>
        {% endif %}
      </div>
      <h1>{{ title }}</h1>
      {% if description %}<p class="article-lead">{{ description }}</p>{% endif %}
    </header>
    <div class="article-body">
      {{ content | safe }}
    </div>
    {% if recommendedArticle %}
    <aside class="article-next{% if recommendedArticle.image %} article-next--with-image{% endif %}" aria-labelledby="next-article-title">
      <div class="article-next-content">
        <p class="article-next-eyebrow">{{ recommendedArticle.eyebrow }}</p>
        <h2 id="next-article-title"><a href="{{ recommendedArticle.url }}">{{ recommendedArticle.title }}</a></h2>
        <p>{{ recommendedArticle.description }}</p>
        <a href="{{ recommendedArticle.url }}" class="article-next-link">{{ recommendedArticle.cta }} <span aria-hidden="true">→</span></a>
      </div>
      {% if recommendedArticle.image %}
      <a href="{{ recommendedArticle.url }}" class="article-next-image" tabindex="-1" aria-hidden="true">
        <img src="{{ recommendedArticle.image }}" alt="{{ recommendedArticle.imageAlt }}" />
      </a>
      {% endif %}
    </aside>
    {% endif %}
    <footer class="article-footer">
      <a href="/articles/" class="btn-back">&larr; Back to Articles</a>
    </footer>
  </div>
</article>
